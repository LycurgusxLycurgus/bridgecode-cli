{
  "name": "@bridgecode/cli",
  "version": "4.3.1",
  "description": "Install, update, and verify Bridgecode repo-local instructions.",
  "type": "module",
  "bin": {
    "bridgecode": "bin/bridgecode.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "README_HUMAN.txt",
    "CHANGELOG.md",
    "LICENSE",
    "payload-manifest.json",
    "bin/",
    "src/",
    "bridgecode/",
    "hooks/",
    "legacy/"
  ],
  "scripts": {
    "build:manifest": "node scripts/build-manifest.mjs",
    "prepack": "npm run build:manifest",
    "test": "node --test test/lifecycle.test.mjs test/safety.test.mjs test/hooks.test.mjs test/policy.test.mjs",
    "test:tarball": "node --test test/tarball.test.mjs",
    "sync:payload": "node scripts/sync-payload.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "keywords": [
    "codex",
    "agents.md",
    "agent",
    "instructions",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LycurgusxLycurgus/bridgecode-cli.git"
  },
  "bugs": {
    "url": "https://github.com/LycurgusxLycurgus/bridgecode-cli/issues"
  },
  "homepage": "https://github.com/LycurgusxLycurgus/bridgecode-cli#readme"
}
