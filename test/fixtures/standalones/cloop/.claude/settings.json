{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(codex exec:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/cloop-turn.mjs\"",
            "statusMessage": "cloop:heartbeat",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/cloop-turn.mjs\"",
            "statusMessage": "cloop:recovery",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
